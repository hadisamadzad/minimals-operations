<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Minimals.Operations</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NuGet Package Properties -->
    <PackageId>Minimals.Operations</PackageId>
    <Version>2.0.0</Version>
    <Authors>Hadi Samadzad</Authors>
    <Company>Hadi Samadzad</Company>
    <Description>A lightweight, type-safe operation result pattern with a compile-time source-generated lazy mediator for .NET use cases and event handling.</Description>
    <PackageTags>operation-pattern;result-pattern;operation-mediator;event-publishing;source-generator;clean-architecture;use-case;error-handling;functional</PackageTags>
    <PackageProjectUrl>https://github.com/hadisamadzad/minimals-operations</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hadisamadzad/minimals-operations</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Version 2 introduces compile-time source-generated lazy operation dispatching and event publishing.</PackageReleaseNotes>
    <Copyright>Copyright (c) 2026 Hadi Samadzad</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Minimals.Operations.Generators/**/*.cs" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
    <None Include="Minimals.Operations.Generators/bin/$(Configuration)/netstandard2.0/Minimals.Operations.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="Minimals.Operations.Generators/Minimals.Operations.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
